{
  "name": "spectrix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unified network intelligence & cybersecurity toolkit (React + Cloudflare Workers)",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8788",
    "build": "npm run typecheck && vite build",
    "preview": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "data:extract": "node scripts/extract-data.mjs",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "setup:kv": "node scripts/setup-kv.mjs",
    "calibrate:phishing": "tsx scripts/phishing-calibration.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
